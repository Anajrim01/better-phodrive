# Send only files required to build the workspaces.
**
!package.json
!bun.lock
!scripts
!scripts/workspaces.mjs
!core
!core/package.json
!core/tsconfig.json
!core/src
!core/src/**
!app
!app/package.json
!app/vite.config.ts
!app/tsconfig.json
!app/tsconfig.server.json
!app/src
!app/src/**
!app/static
!app/static/**
!LICENSE*

# Keep credentials excluded even inside an allowed source directory.
**/.env
**/.env.*
**/.dev.vars
