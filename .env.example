# Matches the db service in compose.yaml.
DATABASE_URL=postgres://phodrive:phodrive@127.0.0.1:5432/phodrive
# Encrypts sessions and stored Google tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional, public sharing only: set both or leave both empty. Encrypts short-lived download
# capabilities. Must be padded base64 of exactly 32 bytes. Use the same value in the Pages Function.
# Generate one with: openssl rand -base64 32
SHARE_CAPABILITY_KEY=
# Optional, public sharing only: public origin of the Cloudflare Pages Function, with no path, query or
# credentials. Must use https, or http on localhost, 127.0.0.1 or [::1].
PUBLIC_EDGE_URL=
# Where files are split and encoded: browser (light servers) or server (powerful servers).
PHODRIVE_PROCESSING=
# Set to true to stop new signups.
PHODRIVE_DISABLE_SIGNUP=false
