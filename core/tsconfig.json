{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
