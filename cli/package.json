        "cli-table3": "^0.6.5",
        "commander": "~15.0.0",
        "env-paths": "^4.0.0",
        "picocolors": "^1.1.1",
        "pretty-bytes": "^7.2.0",
        "results-ts": "^4.4.0",
        "write-file-atomic": "^8.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/write-file-atomic": "^4.0.3",
        "tsdown": "^0.23.2",
        "typescript": "^6.0.3",
