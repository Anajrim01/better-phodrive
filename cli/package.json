{
    "name": "@madkarmaa/phodrive-cli",
    "version": "1.0.0",
    "description": "Command-line interface for Phodrive.",
    "type": "module",
    "license": "MIT",
    "author": "madkarmaa",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/madkarmaa/phodrive.git",
        "directory": "cli"
    },
    "engines": {
        "node": ">=24.21.0"
    },
